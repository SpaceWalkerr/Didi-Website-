# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Postgres connection string. Leave blank locally and bookings go to a JSON
# file under server/data/ instead, so you need no database to develop.
#
# The schema needs the btree_gist extension for the constraint that prevents
# double-booking. The server creates it automatically and refuses to start if
# it cannot — see DEPLOY.md.
# REQUIRED in production — the server refuses to start without it, because the
# JSON fallback would sit on a filesystem that is wiped on every deploy.
#   Neon:     postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
#   Supabase: use the SESSION POOLER string, not "Direct connection" — direct is
#             IPv6-only and most hosts dial out over IPv4:
#             postgresql://postgres.xxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---- Razorpay (TEST MODE) ----
# Get these from https://dashboard.razorpay.com/app/keys (use the "Test Mode" toggle).
# Leave them blank to run in MOCK mode: the booking flow works end-to-end without
# real payments, so you can demo the site before the doctor's account is live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signing secret — a DIFFERENT value from the key secret above. You
# choose it when creating the webhook at Dashboard -> Settings -> Webhooks.
# Without it, a booking is only confirmed if the patient's browser makes it back
# from Checkout; with it, Razorpay tells the server directly.
# REQUIRED in production once the keys are live (rzp_live_...).
RAZORPAY_WEBHOOK_SECRET=

# ---- Manual UPI payments (no payment-gateway account needed) ----
# The doctor's UPI ID. When set, and Razorpay keys are not, patients pay this ID
# directly and enter the UTR; the doctor confirms each payment in /admin.
UPI_ID=
# Name shown in the patient's UPI app (defaults to the doctor's name).
# UPI_PAYEE_NAME=

# ---- Admin ----
# Used by the /admin page, which exposes patient health data.
# In production the server REFUSES TO START with this default or anything
# under 24 characters. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=change-me-please
# Clinic dashboard sign-in (/admin). Both optional:
#   ADMIN_EMAIL    defaults to the clinic email in shared/practice.config.js
#   ADMIN_PASSWORD defaults to ADMIN_TOKEN. Set it (12+ characters) to use a
#                  different password from the API token.
#   SESSION_SECRET signs dashboard and patient sign-in sessions; defaults to a
#                  value derived from the two above. Changing any of them signs everyone out.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# SESSION_SECRET=

# ---- Production only ----
# Where the JSON fallback writes when DATABASE_URL is unset. Local use only.
# DATA_DIR=./data
#
# Allows simulated payments in production. ONLY for a staging site nobody
# will book on. Never set this where patients can reach it.
# ALLOW_DEMO_PAYMENTS=true

# ---- WhatsApp automation (optional; WhatsApp Business Cloud API) ----
# Leave WHATSAPP_PROVIDER unset to keep wa.me click-to-chat links only.
# With cloud-api the server messages the patient by itself: payment received,
# booking confirmed, and a reminder before the slot. Setup: DEPLOY.md "WhatsApp automation".
# WHATSAPP_PROVIDER=cloud-api
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# Languages with an approved template (English is always required):
# WHATSAPP_TEMPLATE_LANGS=en,hi
# Template names, if you named them differently in Meta:
# WHATSAPP_TEMPLATE_RECEIVED=booking_received
# WHATSAPP_TEMPLATE_CONFIRMED=booking_confirmed
# WHATSAPP_TEMPLATE_REMINDER=booking_reminder
# Minutes before the slot that the reminder goes out (default 60):
# WHATSAPP_REMINDER_MINUTES=60

# ---- Notifications ----
# SMS is still log-only (needs DLT registration); see src/services/notify.js.
# SMTP connection URL for confirmation emails to the patient and the doctor.
# Blank = emails are only logged to the console. For Gmail, create an App
# Password (Google Account -> Security -> 2-Step Verification -> App passwords):
#   SMTP_URL=smtps://drricha7273%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
# "From" address; defaults to the clinic email. Must match the SMTP account.
NOTIFY_EMAIL_FROM=
NOTIFY_SMS_SENDER=DRCLNC
