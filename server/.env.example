# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Razorpay (TEST MODE) ----
# Get these from https://dashboard.razorpay.com/app/keys (use the "Test Mode" toggle).
# Leave them blank to run in MOCK mode: the booking flow works end-to-end without
# real payments, so you can demo the site before the doctor's account is live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Admin ----
# Used by the /admin page, which exposes patient health data.
# In production the server REFUSES TO START with this default or anything
# under 24 characters. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=change-me-please

# ---- Production only ----
# Where bookings are stored. Must be a persistent volume in production —
# a container filesystem is wiped on every deploy.
# DATA_DIR=/data
#
# Allows simulated payments in production. ONLY for a staging site nobody
# will book on. Never set this where patients can reach it.
# ALLOW_DEMO_PAYMENTS=true

# ---- Notifications (placeholders) ----
# Wire these up to a real provider later (see src/services/notify.js).
NOTIFY_EMAIL_FROM=clinic@example.com
NOTIFY_SMS_SENDER=DRCLNC
