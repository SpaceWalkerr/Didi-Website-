{
  "name": "dr-consult-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Online consultation website for a solo general physician (India)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run seo && npm run build --workspace client && node -e \"require('fs').copyFileSync('client/dist/index.html','client/dist/404.html')\"",
    "seo": "node scripts/generate-seo.mjs",
    "start": "npm run start --workspace server",
    "setup": "npm install && cp -n server/.env.example server/.env || true",
    "check:i18n": "node scripts/check-translations.mjs",
    "test": "node scripts/test/all.mjs",
    "test:reschedule": "node scripts/test/reschedule.mjs",
    "test:schema": "node scripts/test/schema.mjs",
    "test:api": "node scripts/test/api.mjs",
    "test:race": "node scripts/test/race.mjs",
    "test:payment": "node scripts/test/payment.mjs",
    "test:dashboard": "node scripts/test/dashboard.mjs",
    "test:e2e": "npm run build && playwright test",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
